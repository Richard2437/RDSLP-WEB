# =====================================================
# RDSLP - .gitignore (DevSecOps)
# =====================================================

# Dependencias
node_modules/

# Variables de entorno y credenciales sensibles
.env
.env.*
.env.local
.env.development
.env.production
.env.staging

# Logs y temporales
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.log

# Archivos de IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos de sistema operativo
desktop.ini
ehthumbs.db
Icon?

# Directorios de build
dist/
build/
.vercel/

# Archivos de seguridad - NUNCA subir
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
secrets/
credentials/

# Archivos temporales de bases de datos
*.sqlite
*.sqlite3
*.db

# Coverage y tests
coverage/
.nyc_output/
